# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database (PostgreSQL in-memory via pg-mem)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securepeople
DB_USER=postgres
DB_PASSWORD=postgres

# Google Maps (used by frontend, referenced here for documentation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
